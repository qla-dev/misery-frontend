{
  "expo": {
    "name": "Misery Meter",
    "slug": "misery-meter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miseryindex",
    "userInterfaceStyle": "dark",
    "owner": "kulasin94",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "misery.qla.dev",
      "buildNumber": "5",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Misery Meter connects to the local development game server.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "misery.qla.dev",
      "versionCode": 6,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0a0a"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "revenueCat": {
        "entitlementIdentifier": "misery-pro",
        "offeringIdentifier": "misery-pro",
        "offeringRestId": "ofrng75a5f44275",
        "androidApiKey": "",
        "iosApiKey": "",
        "testStoreApiKey": ""
      },
      "eas": {
        "projectId": "a81f5dc4-e8ec-4326-886d-37bc4cf9718e"
      }
    }
  }
}
