# Add the OAuth client IDs created for the Misery Meter app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# app.config.js automatically adds the reversed iOS client ID as a URL scheme.
# RevenueCat public SDK keys from Project settings > API keys.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=misery-pro
