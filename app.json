{
  "expo": {
    "name": "The Misery Meter",
    "slug": "misery-meter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miseryindex",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "owner": "kulasinn",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "misery.qla.dev",
      "buildNumber": "2",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "misery.qla.dev",
      "versionCode": 1,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0a0a"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
     "eas": {
        "projectId": "43b2501c-9f9a-4ba5-866b-829789ba477b"
      }
    }
  }
}
